{
  "name": "graphql-gene-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "generate:full": "nuxt generate && pagefind --source .output/public",
    "preview": "nuxt preview",
    "mcp:dev": "npm --prefix mcp-server run dev",
