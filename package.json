    "@nuxtjs/i18n": "^10.4.0",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.10.0",
    "graphql": "^16.14.0",
    "graphql-gene": "^1.3.7",
    "nuxt": "^4.4.6",
    "sequelize": "^6.37.8",
    "vue": "latest",
    "vue-router": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.9.1",
    "monaco-editor": "^0.55.1",
    "nuxt-monaco-editor": "^1.4.0",
    "pagefind": "^1.5.2",
